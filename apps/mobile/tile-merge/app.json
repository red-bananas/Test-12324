{
  "expo": {
    "name": "Tile Merge",
    "slug": "tile-merge",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1c1b22"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.autoapp.tilemerge"
    },
    "android": {
      "package": "app.autoapp.tilemerge",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1c1b22"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "35990f7a-93c8-45e0-a540-a6958c5fa195"
      }
    },
    "owner": "sajet-reev"
  }
}
