{
  "expo": {
    "name": "Merge Tiles",
    "slug": "tile-merge",
    "version": "1.1.0",
    "description": "Offline swipe-and-merge puzzle. Beat your best score — optional rewarded ads for bonus undos.",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1c1b22"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.autoapp.tilemerge"
    },
    "android": {
      "package": "app.autoapp.tilemerge",
      "versionCode": 10100,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1c1b22"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8557764165565608~1296387874",
          "iosAppId": "ca-app-pub-8557764165565608~1296387874"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "35990f7a-93c8-45e0-a540-a6958c5fa195"
      }
    },
    "owner": "sajet-reev"
  }
}
