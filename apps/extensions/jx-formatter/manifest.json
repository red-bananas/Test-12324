{
  "manifest_version": 3,
  "name": "JX Formatter",
  "version": "1.0",
  "description": "Format and beautify JSON and XML instantly.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/png/icon16.png",
      "48": "icons/png/icon48.png",
      "128": "icons/png/icon128.png"
    }
  },
  "permissions": [
    "clipboardWrite",
    "clipboardRead",
    "downloads"
  ],
  "icons": {
    "16": "icons/png/icon16.png",
    "48": "icons/png/icon48.png",
    "128": "icons/png/icon128.png"
  }
}
