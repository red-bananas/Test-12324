{
  "manifest_version": 3,
  "name": "File Info — Image Size, Dimensions, Aspect Ratio, File Details",
  "version": "1.1.0",
  "description": "See image width, height, file size, and aspect ratio in one click. Copy dimensions, download files, and inspect PDFs, video, audio, and local files.",
  "icons": {
    "16": "icons/png/icon16.png",
    "48": "icons/png/icon48.png",
    "128": "icons/png/icon128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "downloads",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "file:///*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "File Info",
    "default_icon": {
      "16": "icons/png/icon16.png",
      "48": "icons/png/icon48.png",
      "128": "icons/png/icon128.png"
    }
  }
}
