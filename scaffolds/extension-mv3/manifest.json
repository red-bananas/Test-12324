{
  "manifest_version": 3,
  "name": "Starter Extension",
  "version": "0.1.0",
  "description": "Replace this with a one-line, benefit-first description (max 132 chars). Free, works offline.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/png/icon16.png",
      "48": "icons/png/icon48.png",
      "128": "icons/png/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/png/icon16.png",
    "48": "icons/png/icon48.png",
    "128": "icons/png/icon128.png"
  }
}
